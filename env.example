# Copiar como .env en la raiz y completar los valores privados.
# Nunca versionar .env.
DOMAIN=docker.localhost

DB_HOST=tp1-db
DB_PORT=3306
DB_USER=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Base inicial creada por MariaDB en un volumen nuevo.
MYSQL_DATABASE=fintech_nova

# Bases de las APIs: deben coincidir con los scripts de la imagen publicada.
DB_NAME_CLIENTES=db_clientes
DB_NAME_PAGOS=db_pagos
DB_NAME_FACTURAS=db_facturas
DB_NAME_TARJETAS=db_tarjetas
DB_NAME_TRANSACCIONES=db_transacciones

# Solo se entrega a Transacciones.
IPAPI_TOKEN=
