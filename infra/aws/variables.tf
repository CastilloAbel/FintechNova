variable "aws_region" {
  description = "AWS region enabled for the current Learner Lab session."
  type        = string
}

variable "ami_id" {
  description = "Amazon Linux 2023 x86_64 AMI available in aws_region. AMI IDs are regional."
  type        = string
  default     = "ami-0c230065b91270bc6"
}

variable "instance_type" {
  description = "EC2 instance type for the FinTech Nova sandbox."
  type        = string
  default     = "t3.small"
}

variable "root_volume_size" {
  description = "Root EBS volume size in GiB."
  type        = number
  default     = 20
}

variable "runner_ssh_cidr" {
  description = "Runner's current outbound IPv4 CIDR, for SSH ingress only."
  type        = string

  validation {
    condition     = can(cidrhost(var.runner_ssh_cidr, 0))
    error_message = "runner_ssh_cidr must be a valid IPv4 CIDR, for example 200.10.191.20/32."
  }
}

variable "ssh_public_key" {
  description = "Ephemeral SSH public key generated by the deploy job. Never pass the private key to Terraform."
  type        = string

  validation {
    condition     = startswith(var.ssh_public_key, "ssh-ed25519 ")
    error_message = "ssh_public_key must contain an OpenSSH Ed25519 public key."
  }
}

variable "resource_suffix" {
  description = "Unique safe suffix for EC2 key and security group names."
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z0-9-]{1,32}$", var.resource_suffix))
    error_message = "resource_suffix must contain 1-32 letters, digits, or hyphens."
  }
}
